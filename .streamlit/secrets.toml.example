# Copy to .streamlit/secrets.toml (local) or paste into App settings > Secrets (Streamlit Cloud).
# NEVER commit the real secrets.toml - it is in .gitignore.

# Optional: ask for this password before showing anything (recommended for a public URL).
app_password = "choose-a-password"

# Optional: key for the "AI vision" photo reader. Anyone who can open the app can use it,
# so only set it together with app_password.
# ANTHROPIC_API_KEY = "sk-ant-..."

[email]
sender = "you@gmail.com"
password = "xxxx xxxx xxxx xxxx"        # Gmail app password: https://myaccount.google.com/apppasswords
# default_recipient = "someone@example.com"
# allowed_recipients = ["someone@example.com", "other@example.com"]   # only these can receive reports
# smtp_host = "smtp.gmail.com"
# smtp_port = 587
